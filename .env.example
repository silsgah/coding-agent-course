# =============================================================================
# Coding Agent Course — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys.
# Only GEMINI_API_KEY is required. Everything else is optional.

# --- LLM Providers (pick at least one) ---

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenRouter (free models available: https://openrouter.ai)
OPENROUTER_API_KEY=

# OpenAI (optional, for model-swap experiments in Week 3)
OPENAI_API_KEY=

# Anthropic (optional, for model-swap experiments in Week 3)
ANTHROPIC_API_KEY=

# --- Default Model ---
# Change this to switch your default model across all weeks
DEFAULT_MODEL=gemini-1.5-flash

# --- Sandbox (Week 4+) ---
# Docker is auto-detected. For remote sandboxing:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Observability (Week 8) ---
# OPIK_API_KEY=
